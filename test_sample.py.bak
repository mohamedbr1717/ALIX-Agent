# Mapping of AST binary operators to actual Python functions
_ALLOWED_OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow,
    ast.BitXor: operator.xor,
    ast.BitAnd: operator.and_,
    ast.BitOr: operator.or_,
    ast.LShift: operator.lshift,
    ast.RShift: operator.rshift,
}

# Mapping of AST unary operators to actual Python functions
_ALLOWED_UNARY_OPERATORS = {
    ast.UAdd: operator.pos,
    ast.USub: operator.neg,
    ast.Invert: operator.invert,
    ast.Not: operator.not_,
}


def _evaluate_node(node: ast.AST) -> Any:
    """Recursively evaluate an AST node, allowing only safe operations."""
    if isinstance(node, ast.Expression):
        return _evaluate_node(node.body)

    if isinstance(node, ast.Constant):  # Python 3.8+
        return node.value

    if isinstance(node, ast.Num):  # For older Python versions
        return node.n

    if isinstance(node, ast.BinOp):
        left = _evaluate_node(node.left)
        right = _evaluate_node(node.right)
        op_type = type(node.op)
        if op_type in _ALLOWED_OPERATORS:
            return _ALLOWED_OPERATORS[op_type](left, right)
        raise ValueError(f"Unsupported binary operator: {op_type}")

    if isinstance(node, ast.UnaryOp):
        operand = _evaluate_node(node.operand)
        op_type = type(node.op)
        if op_type in _ALLOWED_UNARY_OPERATORS:
            return _ALLOWED_UNARY_OPERATORS[op_type](operand)
        raise ValueError(f"Unsupported unary operator: {op_type}")

    if isinstance(node, ast.Tuple):
        return tuple(_evaluate_node(elt) for elt in node.elts)

    if isinstance(node, ast.List):
        return [_evaluate_node(elt) for elt in node.elts]

    if isinstance(node, ast.Dict):
        return {
            _evaluate_node(k): _evaluate_node(v)
            for k, v in zip(node.keys, node.values)
        }

    raise ValueError(f"Unsupported expression: {type(node).__name__}")


def safe_eval(expression: str) -> Any:
    """
    Safely evaluate a limited subset of Python expressions.

    Supported features:
    - Numeric literals
    - String literals
    - Tuples, lists, and dictionaries composed of supported literals
    - Basic arithmetic and bitwise operators
    - Unary operators (+, -, ~, not)

    Raises:
        SyntaxError: If the expression cannot be parsed.
        ValueError: If the expression contains disallowed constructs.
    """
    try:
        parsed = ast.parse(expression, mode='eval')
    except SyntaxError as exc:
        raise SyntaxError(f"Invalid syntax: {exc}") from exc

    return _evaluate_node(parsed)


def process_input(data: str) -> Any:
    """
    Process the input string safely and return the evaluated result.

    Returns None if evaluation fails due to syntax errors,
    unsupported operations, or other evaluation issues.
    """
    try:
        result = safe_eval(data)
        return result
    except (SyntaxError, ValueError, TypeError) as exc:
        # Log the exception in a real-world scenario
        return None


if __name__ == "__main__":
    # Example usage
    example = "1 + 2 * (3 - 4) / 5"
    print(f"Evaluating: {example}")
    print("Result:", process_input(example))